# =============================================================================
# SHENA Express — Variables d'environnement Frontend (.env.example)
# Copiez ce fichier vers `.env.local` et renseignez les valeurs de votre projet
# Firebase (Console Firebase > Paramètres du projet > Vos applications > Web).
# N'y placez JAMAIS de clé privée ni de compte de service.
# =============================================================================

# En développement local uniquement : mettre à "true" pour utiliser Firebase Emulator Suite
# (En production, cette variable est ignorée et une vraie configuration est exigée.)
VITE_USE_EMULATORS=false

# Identifiants publics de l'application Web Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Région des Cloud Functions (par défaut : us-east1, proche d'Haïti)
VITE_FIREBASE_FUNCTIONS_REGION=us-east1
