# =============================================================================
# SHENA Express — Variables d'environnement Cloud Functions (functions/.env.example)
# Copiez vers `functions/.env` avant de déployer les Cloud Functions.
# =============================================================================

# Clé API Web publique du projet Firebase (utilisée par Identity Toolkit REST pour
# vérifier le mot de passe lors de la connexion par identifiant client et déclencher
# les e-mails de réinitialisation Firebase Auth).
WEB_API_KEY=

# URL publique de l'application (utilisée dans les liens de réinitialisation)
APP_URL=https://votre-domaine.com

# Région d'exécution des fonctions
FUNCTIONS_REGION=us-east1

# Activer la vérification Firebase App Check sur les fonctions ("true" recommandé en production)
ENFORCE_APP_CHECK=false

# Optionnel : nom de la collection surveillée par l'extension "Trigger Email from Firestore"
# Laisser vide tant qu'aucun service d'envoi d'e-mails transactionnels n'est configuré.
MAIL_COLLECTION=
