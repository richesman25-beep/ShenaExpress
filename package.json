{
  "name": "shena-express",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SHENA Express — plateforme logistique (React + Firebase)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-shena --import=.emulator-data --export-on-exit=.emulator-data",
    "emulators:fresh": "npm run functions:build && firebase emulators:start --project demo-shena",
    "seed": "node scripts/seed-demo.mjs",
    "test": "vitest run --project unit",
    "test:emulators": "npm run functions:build && firebase emulators:exec --project demo-shena --only auth,firestore,functions \"vitest run --project emulator\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:emulators",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "firebase": "^13.2.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
