rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isDesignatedAdminEmail() {
      return signedIn()
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email', '') == 'shenyderj2000@gmail.com';
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? userDoc().get('role', '') : '';
    }

    function userActive() {
      return !userDocExists() || userDoc().get('disabled', false) != true;
    }

    function isStaff() {
      return signedIn()
        && userActive()
        && (
          request.auth.token.get('role', '') in ['admin', 'operator', 'finance_manager']
          || isDesignatedAdminEmail()
          || userRole() in ['admin', 'operator', 'finance_manager']
        );
    }

    // Les permissions du rôle staff sont explicites : ne jamais l'ajouter
    // à isStaff(), qui conserve les droits historiques des anciens rôles.
    function staffPermission(permission) {
      return signedIn() && userActive()
        && request.auth.token.get('role', '') == 'staff'
        && permission in request.auth.token.get('perms', [])
        && (!userDocExists() || (userRole() == 'staff'
          && permission in userDoc().get('permissions', [])));
    }

    function canAccess(permission) {
      return isStaff() || staffPermission(permission);
    }

    function canWriteOperations() {
      return canAccess('clients.write') || canAccess('orders.write')
        || canAccess('shipments.write');
    }

    function isAdmin() {
      return signedIn()
        && userActive()
        && (
          request.auth.token.get('role', '') == 'admin'
          || isDesignatedAdminEmail()
          || userRole() == 'admin'
        );
    }

    function isOwnClientResource() {
      return signedIn()
        && userActive()
        && resource.data.clientUid == request.auth.uid;
    }

    // Comptes utilisateurs et rôles (users/{uid})
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if isAdmin()
        || (
          isDesignatedAdminEmail()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'admin'
          && request.resource.data.disabled == false
        );
      allow delete: if isAdmin();
    }

    // Fiches clients (clients/{clientId})
    match /clients/{clientId} {
      allow read: if canAccess('clients.read') || isOwnClientResource();
      allow create, delete: if canAccess('clients.write');
      allow update: if canAccess('clients.write')
        || (
          isOwnClientResource()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordConfigured', 'updatedAt'])
          && request.resource.data.passwordConfigured == true
        );
    }

    // Correspondance identifiant client -> compte Firebase Auth (clientAuth/{clientId})
    match /clientAuth/{clientId} {
      allow get: if true;
      allow list: if canAccess('clients.read');
      allow create, update, delete: if canAccess('clients.write');
    }

    // Jetons d'invitation et de définition de mot de passe à usage unique (clientPasswordTokens/{tokenId})
    match /clientPasswordTokens/{tokenId} {
      allow get: if true;
      allow list: if canAccess('clients.write');
      allow create: if canAccess('clients.write')
        || (
          request.resource.data.keys().hasOnly(['clientId', 'clientUid', 'authEmail', 'oobCode', 'createdAt', 'expiresAt', 'usedAt'])
          && request.resource.data.usedAt == null
          && request.resource.data.clientId is string
          && exists(/databases/$(database)/documents/clientAuth/$(request.resource.data.clientId))
        );
      allow update: if canAccess('clients.write')
        || (
          resource.data.usedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
          && request.resource.data.usedAt != null
        );
      allow delete: if canAccess('clients.write');
    }

    // Notes administratives privées sur les clients (clientNotes/{clientId} et clientPrivate/{clientId})
    match /clientNotes/{clientId} {
      allow read: if canAccess('clients.read');
      allow write: if canAccess('clients.write');
    }

    match /clientPrivate/{clientId} {
      allow read: if canAccess('clients.read');
      allow write: if canAccess('clients.write');
    }

    // Index d'unicité des numéros de téléphone et e-mails
    match /clientPhones/{phoneKey} {
      allow read: if canAccess('clients.read');
      allow write: if canAccess('clients.write');
    }

    match /clientEmails/{emailKey} {
      allow get: if true;
      allow list: if canAccess('clients.read');
      allow create, update, delete: if canAccess('clients.write');
    }

    // Commandes clients (orders/{orderId})
    match /orders/{orderId} {
      allow read: if canAccess('orders.read') || isOwnClientResource();
      allow create, update, delete: if canAccess('orders.write');
    }

    // Notes internes sur les commandes (orderPrivate/{orderId})
    match /orderPrivate/{orderId} {
      allow read: if canAccess('orders.read');
      allow write: if canAccess('orders.write');
    }

    // Finances et frais des commandes (orderFinance/{orderId})
    match /orderFinance/{orderId} {
      allow read: if canAccess('finance.read') || isOwnClientResource();
      allow create: if canAccess('finance.write') && !request.resource.data.get('accountingManaged', false);
      allow update, delete: if canAccess('finance.write') && !resource.data.get('accountingManaged', false);
    }

    // Colis / expéditions (shipments/{shipmentId})
    match /shipments/{shipmentId} {
      allow read: if canAccess('shipments.read') || isOwnClientResource();
      allow create: if canAccess('shipments.write') && !request.resource.data.get('accountingManaged', false);
      allow update: if canAccess('shipments.write') && (!resource.data.get('accountingManaged', false) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountingManaged','paidAmountCents','shippingPaymentStatus','actualWeightLb','shippingFeeCents','ratePerLbCents','clientUid','clientId','orderIds','lines']));
      allow delete: if canAccess('shipments.write') && !resource.data.get('accountingManaged', false);
    }

    // Notes internes sur les colis (shipmentPrivate/{shipmentId})
    match /shipmentPrivate/{shipmentId} {
      allow read: if canAccess('shipments.read');
      allow write: if canAccess('shipments.write');
    }

    // Historique et événements de suivi (shipmentEvents/{eventId})
    match /shipmentEvents/{eventId} {
      allow read: if canAccess('orders.read') || canAccess('shipments.read') || isOwnClientResource();
      allow create, update, delete: if canAccess('orders.write') || canAccess('shipments.write');
    }

    // Événements internes de suivi (shipmentEventsPrivate/{eventId})
    match /shipmentEventsPrivate/{eventId} {
      allow read: if canAccess('orders.read') || canAccess('shipments.read');
      allow write: if canAccess('orders.write') || canAccess('shipments.write');
    }

    // Enregistrements de paiements (paymentRecords/{paymentId})
    match /paymentRecords/{paymentId} {
      allow read: if canAccess('finance.read') || isOwnClientResource();
      allow create: if canAccess('finance.write') && !('accountingInvoiceId' in request.resource.data);
      allow update, delete: if canAccess('finance.write') && !('accountingInvoiceId' in resource.data);
    }

    // Notifications clients (notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if canAccess('clients.read') || canAccess('orders.read') || canAccess('shipments.read')
        || (signedIn() && userActive() && resource.data.recipientUid == request.auth.uid);
      allow create, delete: if canWriteOperations();
      allow update: if canWriteOperations()
        || (
          signedIn()
          && userActive()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        );
    }

    // Journal d'audit administratif immuable (auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read: if isAdmin() || staffPermission('audit.read');
      allow create: if canWriteOperations() || canAccess('finance.write');
      allow update, delete: if false;
    }

    // Paramètres publics et privés de l'application (settings/public et settings/private)
    match /settings/public {
      allow read: if true;
      allow create: if isAdmin() || (staffPermission('settings.write')
        && !request.resource.data.keys().hasAny(['shippingRatePerLbCents']));
      allow update: if isAdmin() || (staffPermission('settings.write')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shippingRatePerLbCents']));
      allow delete: if isAdmin();
    }

    match /settings/private {
      allow read, write: if isAdmin() || staffPermission('settings.write');
    }

    // Compteurs de séquences d'identifiants (counters/{counterId})
    match /counters/{counterId} {
      allow read, write: if canWriteOperations();
    }

    // File d'envoi d'e-mails (mail/{mailId})
    match /mail/{mailId} {
      allow read, write: if canAccess('clients.write');
    }

    // Comptabilité globale : lecture autorisée, écritures uniquement via Functions Admin SDK.
    function accountingReader() {
      return signedIn() && userActive()
        && (request.auth.token.get('role', '') == 'admin' || isDesignatedAdminEmail()
          || (request.auth.token.get('role', '') == 'staff' && 'finance.read' in request.auth.token.get('perms', [])))
        && (!userDocExists() || userRole() == 'admin'
          || (userRole() == 'staff' && 'finance.read' in userDoc().get('permissions', [])));
    }
    match /{book}/{entry} {
      allow read: if book in ['accountingInvoices','accountingEntries','accountingGoals','accountingSettings','accountingAudit'] && accountingReader();
      allow write: if false;
    }

    // Refus explicite de tout autre accès non prévu
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
