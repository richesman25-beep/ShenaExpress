rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isDesignatedAdminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'shenyderj2000@gmail.com';
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? userDoc().role : null;
    }

    function userActive() {
      return !userDocExists() || userDoc().disabled != true;
    }

    function isStaff() {
      return signedIn()
        && userActive()
        && (
          request.auth.token.role in ['admin', 'operator', 'finance_manager']
          || isDesignatedAdminEmail()
          || userRole() in ['admin', 'operator', 'finance_manager']
        );
    }

    function isAdmin() {
      return signedIn()
        && userActive()
        && (
          request.auth.token.role == 'admin'
          || isDesignatedAdminEmail()
          || userRole() == 'admin'
        );
    }

    function isOwnClientResource() {
      return signedIn()
        && userActive()
        && resource.data.clientUid == request.auth.uid;
    }

    // Comptes utilisateurs et rôles (users/{uid})
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if isAdmin()
        || isStaff()
        || (
          isDesignatedAdminEmail()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'admin'
          && request.resource.data.disabled == false
        );
      allow delete: if isAdmin();
    }

    // Fiches clients (clients/{clientId})
    match /clients/{clientId} {
      allow read: if isStaff() || isOwnClientResource();
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (
          isOwnClientResource()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordConfigured', 'updatedAt'])
          && request.resource.data.passwordConfigured == true
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordConfigured', 'updatedAt'])
          && request.resource.data.passwordConfigured == true
        );
    }

    // Correspondance identifiant client -> compte Firebase Auth (clientAuth/{clientId})
    match /clientAuth/{clientId} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // Jetons d'invitation et de définition de mot de passe à usage unique (clientPasswordTokens/{tokenId})
    match /clientPasswordTokens/{tokenId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff()
        || (
          request.resource.data.keys().hasOnly(['clientId', 'clientUid', 'authEmail', 'oobCode', 'createdAt', 'expiresAt', 'usedAt'])
          && request.resource.data.usedAt == null
          && request.resource.data.clientId is string
        );
      allow update: if isStaff()
        || (
          resource.data.usedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
          && request.resource.data.usedAt != null
        );
      allow delete: if isStaff();
    }

    // Notes administratives privées sur les clients (clientNotes/{clientId} et clientPrivate/{clientId})
    match /clientNotes/{clientId} {
      allow read, write: if isStaff();
    }

    match /clientPrivate/{clientId} {
      allow read, write: if isStaff();
    }

    // Index d'unicité des numéros de téléphone et e-mails
    match /clientPhones/{phoneKey} {
      allow read, write: if isStaff();
    }

    match /clientEmails/{emailKey} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // Commandes clients (orders/{orderId})
    match /orders/{orderId} {
      allow read: if isStaff() || isOwnClientResource();
      allow create, update, delete: if isStaff();
    }

    // Notes internes sur les commandes (orderPrivate/{orderId})
    match /orderPrivate/{orderId} {
      allow read, write: if isStaff();
    }

    // Finances et frais des commandes (orderFinance/{orderId})
    match /orderFinance/{orderId} {
      allow read: if isStaff() || isOwnClientResource();
      allow create, update, delete: if isStaff();
    }

    // Colis / expéditions (shipments/{shipmentId})
    match /shipments/{shipmentId} {
      allow read: if isStaff() || isOwnClientResource();
      allow create, update, delete: if isStaff();
    }

    // Notes internes sur les colis (shipmentPrivate/{shipmentId})
    match /shipmentPrivate/{shipmentId} {
      allow read, write: if isStaff();
    }

    // Historique et événements de suivi (shipmentEvents/{eventId})
    match /shipmentEvents/{eventId} {
      allow read: if isStaff() || isOwnClientResource();
      allow create, update, delete: if isStaff();
    }

    // Événements internes de suivi (shipmentEventsPrivate/{eventId})
    match /shipmentEventsPrivate/{eventId} {
      allow read, write: if isStaff();
    }

    // Enregistrements de paiements (paymentRecords/{paymentId})
    match /paymentRecords/{paymentId} {
      allow read: if isStaff() || isOwnClientResource();
      allow create, update, delete: if isStaff();
    }

    // Notifications clients (notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if isStaff()
        || (signedIn() && userActive() && resource.data.recipientUid == request.auth.uid);
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (
          signedIn()
          && userActive()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        );
    }

    // Journal d'audit administratif immuable (auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Paramètres publics et privés de l'application (settings/public et settings/private)
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/private {
      allow read, write: if isAdmin();
    }

    // Compteurs de séquences d'identifiants (counters/{counterId})
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }

    // File d'envoi d'e-mails (mail/{mailId})
    match /mail/{mailId} {
      allow read, write: if isStaff();
    }

    // Refus explicite de tout autre accès non prévu
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
